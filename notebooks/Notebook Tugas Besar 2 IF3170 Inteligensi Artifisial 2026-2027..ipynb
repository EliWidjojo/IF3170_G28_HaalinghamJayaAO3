      "source": [
        "sklearn_lr_results = []\n",
        "\n",
        "#perbandingan ketiga jenis regularization\n",
        "for config_name, params in lr_configs.items():\n",
        "\n",
        "    if params[\"penalty\"] == \"elastic\":\n",
        "        sk_lr = LogisticRegression(\n",
        "            penalty=\"elasticnet\",\n",
        "            solver=\"saga\",\n",
        "            l1_ratio=0.5,\n",
        "            C=1.0,\n",
        "            max_iter=2000,\n",
        "            random_state=CFG.SEED,\n",
        "        )\n",
        "    elif params[\"penalty\"] == \"l1\":\n",
        "        sk_lr = LogisticRegression(\n",
        "            penalty=\"l1\",\n",
        "            solver=\"liblinear\",\n",
        "            C=1.0,\n",
        "            max_iter=2000,\n",
        "            random_state=CFG.SEED,\n",
        "        )\n",
        "    else:\n",
        "        sk_lr = LogisticRegression(\n",
        "            penalty=\"l2\",\n",
        "            solver=\"lbfgs\",\n",
        "            C=1.0,\n",
        "            max_iter=2000,\n",
        "            random_state=CFG.SEED,\n",
        "        )\n",
        "\n",
        "    #fit pada training set\n",
        "    sk_lr.fit(X_train_lr, y_train_lr)\n",
        "\n",
        "    #prediksi pada validation set\n",
        "    sk_preds = sk_lr.predict(X_val_lr)\n",
        "\n",
        "    sklearn_lr_results.append({\n",
        "        \"Regularization\": config_name,\n",
        "        \"Scratch F1 (macro)\": lr_summary_df.loc[\n",
        "            config_name, \"F1-score (macro)\"\n",
        "        ],\n",
        "        \"Sklearn F1 (macro)\": f1_score(\n",
        "            y_val_lr, sk_preds,\n",
        "            average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"Scratch Accuracy\": lr_summary_df.loc[\n",
        "            config_name, \"Accuracy\"\n",
        "        ],\n",
        "        \"Sklearn Accuracy\": accuracy_score(y_val_lr, sk_preds),\n",
        "    })\n",
        "\n",
        "#summary perbandingan\n",
        "display(pd.DataFrame(sklearn_lr_results).set_index(\"Regularization\"))\n"
      ]
    },
