        "def construct_attributes(frame):\n",
        "    frame = frame.copy()\n",
        "\n",
        "    guest_cols = [c for c in [\"adults\", \"children\", \"babies\"] if c in frame.columns]\n",
        "    night_cols = [c for c in [\"stays_in_weekend_nights\", \"stays_in_week_nights\"] if c in frame.columns]\n",
        "\n",
        "    if guest_cols:\n",
        "        frame[\"total_guests\"] = frame[guest_cols].fillna(0).sum(axis=1)\n",
        "\n",
        "    if night_cols:\n",
        "        frame[\"total_nights\"] = frame[night_cols].fillna(0).sum(axis=1)\n",
        "\n",
        "    if \"total_guests\" in frame.columns and \"total_nights\" in frame.columns:\n",
        "        denominator = frame[\"total_guests\"] * frame[\"total_nights\"]\n",
        "        if \"adr\" in frame.columns:\n",
        "            frame[\"rate_per_guest_night\"] = (\n",
        "                frame[\"adr\"] / denominator.replace(0, np.nan)\n",
        "            )\n",
        "\n",
        "    return frame\n",
        "\n",
        "X_train = construct_attributes(X_train)\n",
        "X_val = construct_attributes(X_val)\n",
        "X_test = construct_attributes(X_test)\n",
        "\n",
        "print(\"Fitur setelah konstruksi:\", X_train.shape[1])\n",
        "display(X_train.head())"
      ]
    },
