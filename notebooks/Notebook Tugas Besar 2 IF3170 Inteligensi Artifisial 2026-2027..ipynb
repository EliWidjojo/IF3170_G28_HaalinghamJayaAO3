      "source": [
        "print(\"=== Missing values per kolom ===\")\n",
        "train_missing = train_df.isna().sum().to_frame(\"train\")\n",
        "test_missing = test_df.isna().sum().to_frame(\"test\")\n",
        "missing_summary = train_missing.join(test_missing, how=\"outer\")\n",
        "missing_summary[\"train_pct\"] = (missing_summary[\"train\"] / len(train_df) * 100).round(2)\n",
        "missing_summary[\"test_pct\"] = (missing_summary[\"test\"] / len(test_df) * 100).round(2)\n",
        "display(\n",
        "    missing_summary[missing_summary[[\"train\", \"test\"]].sum(axis=1) > 0]\n",
        "    .sort_values(\"train\", ascending=False)\n",
        ")\n",
        "\n",
        "missing_per_row = train_df.isna().sum(axis=1)\n",
        "\n",
        "print(\"\\nDistribusi jumlah missing per baris (train):\")\n",
        "display(missing_per_row.value_counts().sort_index().to_frame(\"count\"))\n",
        "print(f\"Max missing per baris: {missing_per_row.max()}\")\n",
        "\n",
        "# Berapa baris dengan missing \"berat\"?\n",
        "for th in [3, 5, 7]:\n",
        "    n = (missing_per_row >= th).sum()\n",
        "    print(f\"Baris dengan ≥{th} missing: {n} ({n/len(train_df)*100:.2f}%)\")\n",
        "\n",
        "print(\"\\n=== Duplikasi ===\")\n",
        "print(f\"Duplikasi baris train: {train_df.duplicated().sum()}\")\n",
        "print(f\"Duplikasi baris test : {test_df.duplicated().sum()}\")\n",
        "print(f\"id unik di train: {train_df['id'].is_unique}\")\n",
        "print(f\"id unik di test : {test_df['id'].is_unique}\")\n",
        "print(f\"id overlap train-test: {len(set(train_df['id']) & set(test_df['id']))}\")\n",
        "\n",
        "print(\"\\n=== Dtype train vs test ===\")\n",
        "common_cols = [c for c in train_df.columns if c != CFG.TARGET]\n",
        "dtype_match = train_df[common_cols].dtypes == test_df[common_cols].dtypes\n",
        "n_match, n_total = int(dtype_match.sum()), len(dtype_match)\n",
        "if dtype_match.all():\n",
        "    print(f\"{n_match}/{n_total} kolom identik\")\n",
        "else:\n",
        "    print(f\"{n_match}/{n_total} kolom match\")\n",
        "    display(dtype_match[~dtype_match].to_frame(\"match\"))\n",
        "\n",
        "print(\"\\n=== Kategori unseen di test ===\")\n",
        "unseen_report = {}\n",
        "for col in CFG.CAT_COLS:\n",
        "    unseen = set(test_df[col].dropna().unique()) - set(train_df[col].dropna().unique())\n",
        "    if unseen:\n",
        "        unseen_report[col] = sorted(unseen)\n",
        "\n",
        "if unseen_report:\n",
        "    print(f\"{len(unseen_report)}/{len(CFG.CAT_COLS)} fitur punya kategori baru di test:\")\n",
        "    for col, vals in unseen_report.items():\n",
        "        print(f\"  - {col}: {vals}\")\n",
        "else:\n",
        "    print(f\"{len(CFG.CAT_COLS)}/{len(CFG.CAT_COLS)} fitur: semua kategori test ada di train\")\n"
      ]
    },
