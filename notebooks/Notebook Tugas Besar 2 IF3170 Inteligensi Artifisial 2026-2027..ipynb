      "source": [
        "# 1. Inisialisasi model CART scikit-learn\n",
        "# Parameter disamakan dengan CART from scratch.\n",
        "dtl_sklearn = DecisionTreeClassifier(\n",
        "    criterion=\"gini\",\n",
        "    max_depth=DTL_MAX_DEPTH,\n",
        "    min_samples_split=DTL_MIN_SPLIT,\n",
        "    min_samples_leaf=DTL_MIN_LEAF,\n",
        "    random_state=CFG.SEED\n",
        ")\n",
        "\n",
        "# 2. Training menggunakan data yang sama\n",
        "dtl_sklearn.fit(X_train_dtl, y_train_dtl)\n",
        "\n",
        "# 3. Prediksi pada validation set\n",
        "y_val_pred_dtl_sklearn = dtl_sklearn.predict(X_val_dtl)\n",
        "\n",
        "# 4. Evaluasi model scikit-learn\n",
        "dtl_sklearn_metrics = {\n",
        "    \"Accuracy\": accuracy_score(\n",
        "        y_val_dtl, y_val_pred_dtl_sklearn\n",
        "    ),\n",
        "    \"Precision (macro)\": precision_score(\n",
        "        y_val_dtl, y_val_pred_dtl_sklearn,\n",
        "        average=\"macro\", zero_division=0\n",
        "    ),\n",
        "    \"Recall (macro)\": recall_score(\n",
        "        y_val_dtl, y_val_pred_dtl_sklearn,\n",
        "        average=\"macro\", zero_division=0\n",
        "    ),\n",
        "    \"F1-score (macro)\": f1_score(\n",
        "        y_val_dtl, y_val_pred_dtl_sklearn,\n",
        "        average=\"macro\", zero_division=0\n",
        "    )\n",
        "}\n",
        "\n",
        "print(\"=== CART SCIKIT-LEARN ===\")\n",
        "print(f\"Jumlah data training : {len(X_train_dtl)}\")\n",
        "print(f\"Jumlah fitur         : {X_train_dtl.shape[1]}\")\n",
        "print(\"Criterion            : gini\")\n",
        "\n",
        "print(\"\\nEvaluation Metrics:\")\n",
        "display(\n",
        "    pd.Series(\n",
        "        dtl_sklearn_metrics,\n",
        "        name=\"CART Scikit-learn\"\n",
        "    ).to_frame()\n",
        ")\n",
        "\n",
        "# 5. Confusion Matrix scikit-learn\n",
        "print(\"\\nConfusion Matrix:\")\n",
        "display(pd.DataFrame(\n",
        "    confusion_matrix(\n",
        "        y_val_dtl,\n",
        "        y_val_pred_dtl_sklearn,\n",
        "        labels=dtl_model.classes_\n",
        "    ),\n",
        "    index=[\n",
        "        f\"Actual {label}\"\n",
        "        for label in dtl_model.classes_\n",
        "    ],\n",
        "    columns=[\n",
        "        f\"Predicted {label}\"\n",
        "        for label in dtl_model.classes_\n",
        "    ]\n",
        "))\n",
        "\n",
        "# 6. Perbandingan CART from scratch vs scikit-learn\n",
        "dtl_comparison = pd.DataFrame({\n",
        "    \"CART From Scratch\": dtl_metrics,\n",
        "    \"CART Scikit-learn\": dtl_sklearn_metrics\n",
        "}).T\n",
        "\n",
        "print(\"\\n=== COMPARISON: FROM SCRATCH VS SCIKIT-LEARN ===\")\n",
        "display(dtl_comparison.round(4))\n",
        "\n",
        "# 7. Selisih performa kedua implementasi\n",
        "dtl_difference = (\n",
        "    dtl_comparison.loc[\"CART Scikit-learn\"]\n",
        "    - dtl_comparison.loc[\"CART From Scratch\"]\n",
        ")\n",
        "\n",
        "print(\"\\n=== PERFORMANCE DIFFERENCE ===\")\n",
        "display(\n",
        "    dtl_difference.rename(\n",
        "        \"Scikit-learn - From Scratch\"\n",
        "    ).to_frame().round(4)\n",
        ")\n",
        "\n",
        "# 8. Classification Report\n",
        "print(\"\\nClassification Report - CART Scikit-learn:\")\n",
        "print(classification_report(\n",
        "    y_val_dtl,\n",
        "    y_val_pred_dtl_sklearn,\n",
        "    zero_division=0\n",
        "))\n"
      ]
    },
