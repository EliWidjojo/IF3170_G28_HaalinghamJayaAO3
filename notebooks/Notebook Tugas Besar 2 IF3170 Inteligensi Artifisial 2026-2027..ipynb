      "source": [
        "#diskretisasi fitur numerik menjadi kategori\n",
        "nb_discretizer = KBinsDiscretizer(\n",
        "    n_bins=5,\n",
        "    encode=\"ordinal\",\n",
        "    strategy=\"quantile\"\n",
        ")\n",
        "\n",
        "#fit hanya pada training set\n",
        "X_train_nb_array = nb_discretizer.fit_transform(X_train_processed)\n",
        "X_val_nb_array = nb_discretizer.transform(X_val_processed)\n",
        "\n",
        "#konversi menjadi DataFrame agar sesuai dengan implementasi NaiveBayes\n",
        "nb_feature_names = X_train_processed.columns\n",
        "\n",
        "X_train_nb = pd.DataFrame(\n",
        "    X_train_nb_array.astype(int),\n",
        "    columns=nb_feature_names\n",
        ")\n",
        "\n",
        "X_val_nb = pd.DataFrame(\n",
        "    X_val_nb_array.astype(int),\n",
        "    columns=nb_feature_names\n",
        ")\n",
        "\n",
        "y_train_nb = y_train_processed.reset_index(drop=True)\n",
        "y_val_nb = y_val_processed.reset_index(drop=True)\n",
        "\n",
        "#eksperimen dengan beberapa nilai Laplace smoothing (alpha)\n",
        "nb_alphas = [0.5, 1.0, 2.0]\n",
        "\n",
        "nb_models = {}\n",
        "nb_results = []\n",
        "\n",
        "for alpha in nb_alphas:\n",
        "    nb_model = NaiveBayes(alpha=alpha)\n",
        "\n",
        "    #fit hanya menggunakan training set\n",
        "    nb_model.fit(X_train_nb, y_train_nb)\n",
        "    nb_models[alpha] = nb_model\n",
        "\n",
        "    #prediksi pada validation set\n",
        "    y_val_pred_nb = nb_model.predict(X_val_nb)\n",
        "\n",
        "    nb_results.append({\n",
        "        \"Alpha\": alpha,\n",
        "        \"Accuracy\": accuracy_score(y_val_nb, y_val_pred_nb),\n",
        "        \"Precision (macro)\": precision_score(\n",
        "            y_val_nb, y_val_pred_nb,\n",
        "            average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"Recall (macro)\": recall_score(\n",
        "            y_val_nb, y_val_pred_nb,\n",
        "            average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"F1-score (macro)\": f1_score(\n",
        "            y_val_nb, y_val_pred_nb,\n",
        "            average=\"macro\", zero_division=0\n",
        "        ),\n",
        "    })\n",
        "\n",
        "    print(f\"=== Naive Bayes (alpha={alpha}) ===\")\n",
        "    print(classification_report(\n",
        "        y_val_nb, y_val_pred_nb, zero_division=0\n",
        "    ))\n",
        "\n",
        "#ringkasan hasil eksperimen\n",
        "nb_summary_df = pd.DataFrame(nb_results).set_index(\"Alpha\")\n",
        "display(nb_summary_df)\n",
        "\n",
        "#pilih model terbaik berdasarkan Macro F1-score\n",
        "best_nb_alpha = nb_summary_df[\"F1-score (macro)\"].idxmax()\n",
        "best_nb_model = nb_models[best_nb_alpha]\n",
        "y_val_pred_nb = best_nb_model.predict(X_val_nb)\n",
        "\n",
        "print(f\"\\nBest Naive Bayes Alpha: {best_nb_alpha}\")\n",
        "print(\"Confusion Matrix:\")\n",
        "display(pd.DataFrame(\n",
        "    confusion_matrix(y_val_nb, y_val_pred_nb),\n",
        "    index=[f\"Actual {label}\" for label in best_nb_model.classes],\n",
        "    columns=[f\"Predicted {label}\" for label in best_nb_model.classes],\n",
        "))\n"
      ]
    },
