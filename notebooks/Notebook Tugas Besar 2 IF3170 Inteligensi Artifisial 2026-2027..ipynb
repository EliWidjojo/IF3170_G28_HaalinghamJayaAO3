      "source": [
        "\n",
        "# Deteksi batas outlier dengan metode IQR pada training set.\n",
        "# Batas diterapkan ke validation dan test agar tidak terjadi data leakage.\n",
        "numeric_for_outlier = X_train.select_dtypes(include=np.number).columns.tolist()\n",
        "outlier_bounds = {}\n",
        "\n",
        "for col in numeric_for_outlier:\n",
        "    q1 = X_train[col].quantile(0.25)\n",
        "    q3 = X_train[col].quantile(0.75)\n",
        "    iqr = q3 - q1\n",
        "    lower = q1 - CFG.OUTLIER_IQR_FACTOR * iqr\n",
        "    upper = q3 + CFG.OUTLIER_IQR_FACTOR * iqr\n",
        "    outlier_bounds[col] = (lower, upper)\n",
        "\n",
        "    n_outliers = ((X_train[col] < lower) | (X_train[col] > upper)).sum()\n",
        "    if n_outliers:\n",
        "        print(f\"{col}: {n_outliers} outlier\")\n",
        "\n",
        "def clip_outliers(frame, bounds):\n",
        "    frame = frame.copy()\n",
        "    for col, (lower, upper) in bounds.items():\n",
        "        if col in frame.columns:\n",
        "            frame[col] = frame[col].clip(lower=lower, upper=upper)\n",
        "    return frame\n",
        "\n",
        "X_train = clip_outliers(X_train, outlier_bounds)\n",
        "X_val = clip_outliers(X_val, outlier_bounds)\n",
        "X_test = clip_outliers(X_test, outlier_bounds)"
      ]
    },
