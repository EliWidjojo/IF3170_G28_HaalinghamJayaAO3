      "source": [
        "\n",
        "#konversi fitur hasil preprocessing menjadi NumPy array\n",
        "X_train_lr = X_train_processed.to_numpy(dtype=float)\n",
        "X_val_lr = X_val_processed.to_numpy(dtype=float)\n",
        "y_train_lr = y_train_processed.to_numpy()\n",
        "y_val_lr = y_val_processed.to_numpy()\n",
        "\n",
        "#eksperimen untuk tiga jenis regularization\n",
        "lr_configs = {\n",
        "    \"L1\": {\n",
        "        \"penalty\": \"l1\",\n",
        "        \"lambda1\": 0.01,\n",
        "        \"lambda2\": 0.0,\n",
        "    },\n",
        "    \"L2\": {\n",
        "        \"penalty\": \"l2\",\n",
        "        \"lambda1\": 0.0,\n",
        "        \"lambda2\": 0.01,\n",
        "    },\n",
        "    \"Elastic Net\": {\n",
        "        \"penalty\": \"elastic\",\n",
        "        \"lambda1\": 0.01,\n",
        "        \"lambda2\": 0.01,\n",
        "    },\n",
        "}\n",
        "\n",
        "lr_models = {}\n",
        "lr_results = []\n",
        "\n",
        "for config_name, params in lr_configs.items():\n",
        "    lr_model = LogisticReg(\n",
        "        learning_rate=0.01,\n",
        "        n_epochs=200,\n",
        "        penalty=params[\"penalty\"],\n",
        "        lambda1=params[\"lambda1\"],\n",
        "        lambda2=params[\"lambda2\"],\n",
        "        batch_size=256,\n",
        "        shuffle=True,\n",
        "        random_state=CFG.SEED,\n",
        "    )\n",
        "\n",
        "    #fit hanya menggunakan training set\n",
        "    lr_model.fit(X_train_lr, y_train_lr)\n",
        "    lr_models[config_name] = lr_model\n",
        "\n",
        "    #prediksi pada validation set\n",
        "    y_val_pred_lr = lr_model.predict(X_val_lr)\n",
        "\n",
        "    #eval performa model\n",
        "    lr_results.append({\n",
        "        \"Regularization\": config_name,\n",
        "        \"Accuracy\": accuracy_score(y_val_lr, y_val_pred_lr),\n",
        "        \"Precision (macro)\": precision_score(\n",
        "            y_val_lr, y_val_pred_lr,\n",
        "            average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"Recall (macro)\": recall_score(\n",
        "            y_val_lr, y_val_pred_lr,\n",
        "            average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"F1-score (macro)\": f1_score(\n",
        "            y_val_lr, y_val_pred_lr,\n",
        "            average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"Final Log Loss\": lr_model.logloss_history[-1],\n",
        "        \"Epochs\": lr_model.n_epochs_run,\n",
        "    })\n",
        "\n",
        "    print(f\"=== Logistic Regression ({config_name}) ===\")\n",
        "    print(classification_report(\n",
        "        y_val_lr, y_val_pred_lr, zero_division=0\n",
        "    ))\n",
        "\n",
        "#summary hasil ketiga konfigurasi\n",
        "lr_summary_df = pd.DataFrame(lr_results).set_index(\"Regularization\")\n",
        "display(lr_summary_df)\n",
        "\n",
        "#pilih model terbaik berdasarkan Macro F1-score\n",
        "best_lr_config = lr_summary_df[\"F1-score (macro)\"].idxmax()\n",
        "best_lr_model = lr_models[best_lr_config]\n",
        "y_val_pred_lr = best_lr_model.predict(X_val_lr)\n",
        "\n",
        "print(f\"\\nBest Logistic Regression: {best_lr_config}\")\n",
        "print(\"Confusion Matrix:\")\n",
        "display(pd.DataFrame(\n",
        "    confusion_matrix(y_val_lr, y_val_pred_lr),\n",
        "    index=[f\"Actual {label}\" for label in best_lr_model.classes],\n",
        "    columns=[f\"Predicted {label}\" for label in best_lr_model.classes],\n",
        "))\n"
      ]
    },
