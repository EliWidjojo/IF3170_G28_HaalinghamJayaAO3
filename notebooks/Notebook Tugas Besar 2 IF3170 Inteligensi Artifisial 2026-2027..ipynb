      "source": [
        "# konversi DataFrame hasil preprocessing menjadi NumPy array.\n",
        "X_train_knn = X_train_processed.to_numpy(dtype=float)\n",
        "X_val_knn = X_val_processed.to_numpy(dtype=float)\n",
        "y_train_knn = y_train_processed.to_numpy()\n",
        "y_val_knn = y_val_processed.to_numpy()\n",
        "\n",
        "# default KNN.\n",
        "KNN_K = 5\n",
        "KNN_DISTANCE_METRIC = \"euclidean\"  # euclidean, manhattan, minkowski\n",
        "KNN_WEIGHTS = \"uniform\"            # uniform, distance\n",
        "\n",
        "knn_model = KNN(\n",
        "    k=KNN_K,\n",
        "    distance_metric=KNN_DISTANCE_METRIC,\n",
        "    weights=KNN_WEIGHTS,\n",
        ")\n",
        "\n",
        "# Fit hanya pakai data training hasil preprocessing.\n",
        "knn_model.fit(X_train_knn, y_train_knn)\n",
        "\n",
        "# Prediksi dan evaluasi pakai validation set.\n",
        "y_val_pred_knn = knn_model.predict(X_val_knn)\n",
        "\n",
        "knn_metrics = {\n",
        "    \"Accuracy\": accuracy_score(y_val_knn, y_val_pred_knn),\n",
        "    \"Precision (macro)\": precision_score(\n",
        "        y_val_knn, y_val_pred_knn, average=\"macro\", zero_division=0\n",
        "    ),\n",
        "    \"Recall (macro)\": recall_score(\n",
        "        y_val_knn, y_val_pred_knn, average=\"macro\", zero_division=0\n",
        "    ),\n",
        "    \"F1-score (macro)\": f1_score(\n",
        "        y_val_knn, y_val_pred_knn, average=\"macro\", zero_division=0\n",
        "    ),\n",
        "}\n",
        "\n",
        "print(f\"KNN configuration: k={KNN_K}, metric={KNN_DISTANCE_METRIC}, weights={KNN_WEIGHTS}\")\n",
        "display(pd.Series(knn_metrics, name=\"Validation Score\").to_frame())\n",
        "\n",
        "print(\"\\\\nClassification Report:\")\n",
        "print(classification_report(y_val_knn, y_val_pred_knn, zero_division=0))\n",
        "\n",
        "print(\"Confusion Matrix:\")\n",
        "display(pd.DataFrame(\n",
        "    confusion_matrix(y_val_knn, y_val_pred_knn),\n",
        "    index=[f\"Actual {label}\" for label in knn_model.classes_],\n",
        "    columns=[f\"Predicted {label}\" for label in knn_model.classes_],\n",
        "))\n"
      ]
    },
