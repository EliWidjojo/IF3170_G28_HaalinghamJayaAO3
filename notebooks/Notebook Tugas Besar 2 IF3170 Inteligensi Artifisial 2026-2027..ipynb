        "def correct_data_errors(frame):\n",
        "    frame = frame.copy()\n",
        "\n",
        "    # Rapikan whitespace pada atribut kategorikal.\n",
        "    categorical = frame.select_dtypes(include=[\"object\", \"category\"]).columns\n",
        "    for col in categorical:\n",
        "        frame[col] = frame[col].map(\n",
        "            lambda value: value.strip() if isinstance(value, str) else value\n",
        "        )\n",
        "\n",
        "    non_negative_candidates = [\n",
        "        \"adults\", \"children\", \"babies\",\n",
        "        \"stays_in_weekend_nights\", \"stays_in_week_nights\",\n",
        "        \"previous_cancellations\", \"previous_bookings_not_canceled\",\n",
        "        \"booking_changes\", \"days_in_waiting_list\",\n",
        "        \"required_car_parking_spaces\", \"total_of_special_requests\",\n",
        "        \"adr\",\n",
        "    ]\n",
        "    for col in non_negative_candidates:\n",
        "        if col in frame.columns:\n",
        "            frame[col] = pd.to_numeric(frame[col], errors=\"coerce\")\n",
        "            frame.loc[frame[col] < 0, col] = np.nan\n",
        "\n",
        "    return frame\n",
        "\n",
        "X_train = correct_data_errors(X_train)\n",
        "X_val = correct_data_errors(X_val)\n",
        "X_test = correct_data_errors(X_test)\n",
        "\n",
        "print(\"Pembersihan tipe dan nilai tidak valid selesai.\")"
