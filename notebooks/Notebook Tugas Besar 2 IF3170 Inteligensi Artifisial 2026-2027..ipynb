        "MODEL_DIR = Path(CFG.OUTPUT_DIR) / 'models'\n",
        "MODEL_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "model_registry = {\n",
        "    'knn': knn_model,\n",
        "    'dtl_cart': dtl_model,\n",
        "    **{f'logreg_{name.lower().replace(\" \", \"_\")}': m for name, m in lr_models.items()},\n",
        "    **{f'svm_{name}': m for name, m in svm_models.items()},\n",
        "    **{f'naive_bayes_alpha_{str(alpha).replace(\".\", \"_\")}': m for alpha, m in nb_models.items()},\n",
        "}\n",
        "for name, model in model_registry.items():\n",
        "    file = MODEL_DIR / f'{name}.pkl'\n",
        "    if hasattr(model, 'save_model'):\n",
        "        model.save_model(str(file))\n",
        "    elif hasattr(model, 'save'):\n",
        "        model.save(file)\n",
        "    else:\n",
        "        with file.open('wb') as f:\n",
        "            pickle.dump(model, f)\n",
        "\n",
        "#nyimpen pipeline dan transformasi/fitting yang diperlukan pada test data\n",
        "preprocessing_bundle = {\n",
        "    'preprocessor': preprocessor,\n",
        "    'dimensionality_reducer': dimensionality_reducer,\n",
        "    'nb_discretizer': nb_discretizer,\n",
        "    'feature_names': list(X_train_processed.columns),\n",
        "    'dtl_feature_indices': np.asarray(DTL_FEATURE_IDX),\n",
        "    'dtl_feature_names': DTL_FEATURE_NAMES,\n",
        "    'dtl_train_indices': np.asarray(DTL_TRAIN_IDX),\n",
        "    'train_feature_columns': list(X_train.columns),\n",
        "    'outlier_bounds': outlier_bounds,\n",
        "    'all_missing_cols': all_missing_cols,\n",
        "    'seed': CFG.SEED,\n",
        "    'best_lr_config': best_lr_config,\n",
        "    'best_svm_kernel': best_svm_kernel,\n",
        "    'best_nb_alpha': best_nb_alpha,\n",
        "}\n",
        "with (MODEL_DIR / 'preprocessing_bundle.pkl').open('wb') as f:\n",
        "    pickle.dump(preprocessing_bundle, f)\n",
        "\n",
        "#reload pake API asli dari setiap kelas\n",
        "reloaded_models = {}\n",
        "for name, model in model_registry.items():\n",
        "    file = MODEL_DIR / f'{name}.pkl'\n",
        "    if hasattr(type(model), 'load_model'):\n",
        "        restored = type(model).load_model(str(file))\n",
        "    elif hasattr(type(model), 'load'):\n",
        "        restored = type(model).load(file)\n",
        "    else:\n",
        "        with file.open('rb') as f:\n",
        "            restored = pickle.load(f)\n",
        "    reloaded_models[name] = restored\n",
        "\n",
        "with (MODEL_DIR / 'preprocessing_bundle.pkl').open('rb') as f:\n",
        "    reloaded_preprocessing = pickle.load(f)\n",
        "\n",
        "#nguji kalau model setelah reload ttp ngasih prediksi sama dengan sebelum save\n",
        "validation_inputs = {\n",
        "    'knn': X_val_knn,\n",
        "    'dtl_cart': X_val_dtl,\n",
        "    **{f'logreg_{name.lower().replace(\" \", \"_\")}': X_val_lr for name in lr_models},\n",
        "    **{f'svm_{name}': X_val_svm for name in svm_models},\n",
        "    **{f'naive_bayes_alpha_{str(alpha).replace(\".\", \"_\")}': X_val_nb for alpha in nb_models},\n",
        "}\n",
        "for name, model in model_registry.items():\n",
        "    X_check = validation_inputs[name]\n",
        "    before = np.asarray(model.predict(X_check))\n",
        "    after = np.asarray(reloaded_models[name].predict(X_check))\n",
        "    if not np.array_equal(before, after):\n",
        "        raise AssertionError(f'Save/load berbeda: {name}')\n",
        "\n",
        "assert reloaded_preprocessing['feature_names'] == list(X_train_processed.columns)\n",
        "print(f'Sukses menyimpan dan memuat ulang {len(model_registry)} model.')\n",
        "print('Folder:', MODEL_DIR.resolve())\n",
        "print('Prediksi seluruh model identik sebelum/sesudah save/load.')\n"
      ]
    },
