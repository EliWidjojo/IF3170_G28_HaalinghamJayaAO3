        "sample_path = Path(CFG.DATA_DIR) / 'sample_submission.csv'\n",
        "if not sample_path.exists():\n",
        "    raise FileNotFoundError(f'Template Kaggle tidak ditemukan: {sample_path}')\n",
        "submission_template = pd.read_csv(sample_path, dtype={'id': str})\n",
        "expected_cols = ['id', CFG.TARGET]\n",
        "if list(submission_template.columns) != expected_cols:\n",
        "    raise ValueError(f'Kolom submission seharusnya {expected_cols}, aktual {list(submission_template.columns)}')\n",
        "if len(submission_template) != len(X_test_processed):\n",
        "    raise ValueError('Jumlah baris test dan sample_submission berbeda')\n",
        "if 'id' not in test_df.columns:\n",
        "    raise ValueError('Kolom id tidak tersedia pada test.csv')\n",
        "if not np.array_equal(submission_template['id'].to_numpy(), test_df['id'].astype(str).to_numpy()):\n",
        "    raise ValueError('Urutan id sample_submission tidak sama dengan test.csv')\n",
        "\n",
        "#note: ini 5 kandidat dari model yang dilatih hanya pada training split\n",
        "X_test_knn = X_test_processed.to_numpy(dtype=float)\n",
        "X_test_lr = X_test_processed.to_numpy(dtype=float)\n",
        "X_test_svm = X_test_processed.to_numpy(dtype=float)\n",
        "X_test_nb = pd.DataFrame(\n",
        "    nb_discretizer.transform(X_test_processed).astype(int),\n",
        "    columns=X_train_nb.columns\n",
        ")\n",
        "\n",
        "submission_jobs = {\n",
        "    'knn': (knn_model, X_test_knn),\n",
        "    'dtl_cart': (dtl_model, X_test_dtl),\n",
        "    'logreg': (best_lr_model, X_test_lr),\n",
        "    'svm': (best_svm_model, X_test_svm),\n",
        "    'naive_bayes': (best_nb_model, X_test_nb),\n",
        "}\n",
        "\n",
        "candidate_rows = []\n",
        "for name, (model, test_features) in submission_jobs.items():\n",
        "    prediction = np.asarray(model.predict(test_features)).ravel()\n",
        "    if len(prediction) != len(submission_template):\n",
        "        raise ValueError(f'Jumlah prediksi tidak sesuai untuk {name}')\n",
        "    if not np.isin(prediction, np.unique(train_df[CFG.TARGET])).all():\n",
        "        raise ValueError(f'Label prediksi di luar kelas training: {name}')\n",
        "    submission = submission_template[['id']].copy()\n",
        "    submission[CFG.TARGET] = prediction.astype(int)\n",
        "    output_file = Path(CFG.OUTPUT_DIR) / f'submission_{name}_candidate.csv'\n",
        "    output_file.parent.mkdir(parents=True, exist_ok=True)\n",
        "    submission.to_csv(output_file, index=False)\n",
        "    #round-trip: file hasil baca harus sama persis dengan yang dibuat\n",
        "    check = pd.read_csv(output_file, dtype={'id': str})\n",
        "    pd.testing.assert_frame_equal(submission, check, check_dtype=False)\n",
        "    candidate_rows.append({'Algorithm': name, 'Rows': len(submission), 'File': str(output_file)})\n",
        "\n",
        "display(pd.DataFrame(candidate_rows))\n",
        "print('Model teratas berdasarkan validation Macro F1:', best_model_name)\n",
        "print('PERINGATAN: file di atas adalah kandidat awal, bukan final full-refit.')\n",
        "print('Untuk final, lakukan refit preprocessing dan model yang dipilih pada seluruh data berlabel,')\n",
        "print('lalu buat kembali CSV dengan urutan id dan kolom yang sama.')\n",
        "\n",
        "#opsional for final submission: refit winning model pada semua data berlabel (train + validation) dan refit processor\n",
        "#aktifinnya pas eksperimen selesai aja, full refit bisa lama\n",
        "RUN_FINAL_REFIT = False\n",
        "\n",
        "if RUN_FINAL_REFIT:\n",
        "    from sklearn.base import clone\n",
        "    import pickle\n",
        "\n",
        "    #X_train dan X_val udh ngelewatin cleaning/feature construction yang sama jadi jangan masukkin label atau ID sebagai fitur, Y_train mentah abis dedup\n",
        "    X_full_features = pd.concat([X_train, X_val], ignore_index=True)\n",
        "    y_full_labels = pd.concat(\n",
        "        [y_train.reset_index(drop=True), y_val.reset_index(drop=True)],\n",
        "        ignore_index=True\n",
        "    ).to_numpy()\n",
        "\n",
        "    final_preprocessor = clone(preprocessor)\n",
        "    final_full_matrix = final_preprocessor.fit_transform(X_full_features)\n",
        "    final_test_matrix = final_preprocessor.transform(X_test)\n",
        "\n",
        "    final_reducer = None\n",
        "    if dimensionality_reducer is not None:\n",
        "        final_reducer = clone(dimensionality_reducer)\n",
        "        final_full_matrix = final_reducer.fit_transform(final_full_matrix)\n",
        "        final_test_matrix = final_reducer.transform(final_test_matrix)\n",
        "\n",
        "    final_full_matrix = np.asarray(final_full_matrix, dtype=float)\n",
        "    final_test_matrix = np.asarray(final_test_matrix, dtype=float)\n",
        "\n",
        "    final_discretizer = None\n",
        "    final_feature_idx = None\n",
        "    if best_model_name == 'KNN':\n",
        "        final_model = KNN(k=KNN_K, distance_metric=KNN_DISTANCE_METRIC, weights=KNN_WEIGHTS)\n",
        "        final_X_train, final_X_test = final_full_matrix, final_test_matrix\n",
        "    elif best_model_name == 'Decision Tree (CART)':\n",
        "        #note: CART from scratch itu mahal bgt jadi eksekusi mungkin lama\n",
        "        final_variances = np.nan_to_num(np.var(final_full_matrix, axis=0))\n",
        "        final_feature_idx = np.sort(np.argsort(-final_variances, kind='stable')[:DTL_MAX_FEATURES])\n",
        "        final_X_train = final_full_matrix[:, final_feature_idx]\n",
        "        final_X_test = final_test_matrix[:, final_feature_idx]\n",
        "        final_model = DecisionTreeCART(max_depth=DTL_MAX_DEPTH,\n",
        "                                       min_samples_split=DTL_MIN_SPLIT,\n",
        "                                       min_samples_leaf=DTL_MIN_LEAF)\n",
        "    elif best_model_name == 'Logistic Regression':\n",
        "        params = lr_configs[best_lr_config]\n",
        "        final_model = LogisticReg(learning_rate=0.01, n_epochs=200,\n",
        "                                  penalty=params['penalty'], lambda1=params['lambda1'],\n",
        "                                  lambda2=params['lambda2'], batch_size=256,\n",
        "                                  shuffle=True, random_state=CFG.SEED)\n",
        "        final_X_train, final_X_test = final_full_matrix, final_test_matrix\n",
        "    elif best_model_name == 'SVM':\n",
        "        kernel_name = best_svm_kernel\n",
        "        final_model = SVM(kernel=kernel_name, C=1.0, degree=3, gamma='scale',\n",
        "                          coef0=1.0, lr=0.01 if kernel_name == 'linear' else 0.005,\n",
        "                          epochs=50, max_kernel_samples=2000, random_state=CFG.SEED)\n",
        "        final_X_train, final_X_test = final_full_matrix, final_test_matrix\n",
        "    elif best_model_name == 'Naive Bayes':\n",
        "        final_discretizer = KBinsDiscretizer(n_bins=5, encode='ordinal', strategy='quantile')\n",
        "        final_X_train = final_discretizer.fit_transform(final_full_matrix).astype(int)\n",
        "        final_X_test = final_discretizer.transform(final_test_matrix).astype(int)\n",
        "        if final_reducer is not None:\n",
        "            final_columns = [f'PC{i+1}' for i in range(final_full_matrix.shape[1])]\n",
        "        else:\n",
        "            final_columns = list(final_preprocessor.get_feature_names_out())\n",
        "        final_X_train = pd.DataFrame(final_X_train, columns=final_columns)\n",
        "        final_X_test = pd.DataFrame(final_X_test, columns=final_columns)\n",
        "        final_model = NaiveBayes(alpha=best_nb_alpha)\n",
        "    else:\n",
        "        raise ValueError('Model terbaik belum dikenali')\n",
        "\n",
        "    final_model.fit(final_X_train, y_full_labels)\n",
        "    final_prediction = np.asarray(final_model.predict(final_X_test)).ravel().astype(int)\n",
        "    final_submission = submission_template[['id']].copy()\n",
        "    final_submission[CFG.TARGET] = final_prediction\n",
        "    final_path = Path(CFG.OUTPUT_DIR) / 'submission_FINAL_refit.csv'\n",
        "    final_submission.to_csv(final_path, index=False)\n",
        "    assert len(final_submission) == len(submission_template)\n",
        "    assert final_submission['id'].equals(submission_template['id'])\n",
        "\n",
        "    final_bundle = {\n",
        "        'selected_model_name': best_model_name,\n",
        "        'model': final_model,\n",
        "        'preprocessor': final_preprocessor,\n",
        "        'dimensionality_reducer': final_reducer,\n",
        "        'nb_discretizer': final_discretizer,\n",
        "        'dtl_feature_idx': final_feature_idx,\n",
        "        'seed': CFG.SEED,\n",
        "    }\n",
        "    with (MODEL_DIR / 'final_model_and_preprocessing.pkl').open('wb') as f:\n",
        "        pickle.dump(final_bundle, f)\n",
        "    print('Submission final:', final_path, ' | rows:', len(final_submission))\n",
        "    display(final_submission.head())\n",
        "else:\n",
        "    print('Full-refit belum dijalankan. Ubah RUN_FINAL_REFIT=True setelah evaluasi siap.')\n"
      ]
