      "source": [
        "# Konversi DataFrame hasil preprocessing menjadi NumPy array\n",
        "X_train_svm = X_train_processed.to_numpy(dtype=float)\n",
        "X_val_svm = X_val_processed.to_numpy(dtype=float)\n",
        "y_train_svm = y_train_processed.to_numpy()\n",
        "y_val_svm = y_val_processed.to_numpy()\n",
        "\n",
        "# Eksperimen untuk ketiga kernel: Linear, Polynomial, dan Gaussian\n",
        "svm_kernels = [\"linear\", \"poly\", \"rbf\"]\n",
        "svm_models = {}\n",
        "svm_results = []\n",
        "\n",
        "for kernel_name in svm_kernels:\n",
        "    svm_model = SVM(\n",
        "        kernel=kernel_name,\n",
        "        C=1.0,\n",
        "        degree=3,\n",
        "        gamma=\"scale\",\n",
        "        coef0=1.0,\n",
        "        lr=0.01 if kernel_name == \"linear\" else 0.005,\n",
        "        epochs=50,\n",
        "        max_kernel_samples=2000,  # supaya aman untuk RAM\n",
        "        random_state=CFG.SEED,\n",
        "    )\n",
        "\n",
        "    # Fit hanya menggunakan data training hasil preprocessing\n",
        "    svm_model.fit(X_train_svm, y_train_svm)\n",
        "    svm_models[kernel_name] = svm_model\n",
        "\n",
        "    # Prediksi dan evaluasi menggunakan validation set\n",
        "    y_val_pred_svm = svm_model.predict(X_val_svm)\n",
        "\n",
        "    # Variabel total slack sesuai petunjuk rubrik\n",
        "    slack_total = svm_model.slack_total\n",
        "\n",
        "    svm_results.append({\n",
        "        \"Kernel\": kernel_name,\n",
        "        \"Accuracy\": accuracy_score(y_val_svm, y_val_pred_svm),\n",
        "        \"Precision (macro)\": precision_score(\n",
        "            y_val_svm, y_val_pred_svm, average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"Recall (macro)\": recall_score(\n",
        "            y_val_svm, y_val_pred_svm, average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"F1-score (macro)\": f1_score(\n",
        "            y_val_svm, y_val_pred_svm, average=\"macro\", zero_division=0\n",
        "        ),\n",
        "        \"Total Slack\": slack_total,\n",
        "    })\n",
        "\n",
        "    print(f\"=== SVM ({kernel_name.upper()}) | Total Slack: {slack_total:.2f} ===\")\n",
        "    print(classification_report(y_val_svm, y_val_pred_svm, zero_division=0))\n",
        "\n",
        "# Summary perbandingan\n",
        "svm_summary_df = pd.DataFrame(svm_results).set_index(\"Kernel\")\n",
        "display(svm_summary_df)\n",
        "\n",
        "# Pilih model SVM terbaik berdasarkan F1-score untuk evaluasi & confusion matrix\n",
        "best_svm_kernel = svm_summary_df[\"F1-score (macro)\"].idxmax()\n",
        "best_svm_model = svm_models[best_svm_kernel]\n",
        "y_val_pred_svm = best_svm_model.predict(X_val_svm)\n",
        "\n",
        "print(f\"\\nBest SVM Kernel: {best_svm_kernel.upper()}\")\n",
        "print(\"Confusion Matrix:\")\n",
        "display(pd.DataFrame(\n",
        "    confusion_matrix(y_val_svm, y_val_pred_svm),\n",
        "    index=[f\"Actual {label}\" for label in best_svm_model.classes_],\n",
        "    columns=[f\"Predicted {label}\" for label in best_svm_model.classes_],\n",
        "))"
      ]
