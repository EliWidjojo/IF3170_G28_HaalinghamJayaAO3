      "source": [
        "# Konversi fitur validation dan training sudah dilakukan pada bagian KNN.\n",
        "# Gunakan konfigurasi yang sama agar perbandingan adil.\n",
        "sklearn_knn = KNeighborsClassifier(\n",
        "    n_neighbors=KNN_K,\n",
        "    metric=KNN_DISTANCE_METRIC,\n",
        "    weights=KNN_WEIGHTS,\n",
        "    p=3 if KNN_DISTANCE_METRIC == \"minkowski\" else 2,\n",
        "    n_jobs=-1,\n",
        ")\n",
        "\n",
        "# Fit hanya menggunakan data training hasil preprocessing.\n",
        "sklearn_knn.fit(X_train_knn, y_train_knn)\n",
        "\n",
        "# Prediksi dan evaluasi pada validation set.\n",
        "sklearn_knn_preds = sklearn_knn.predict(X_val_knn)\n",
        "\n",
        "sklearn_knn_results = [{\n",
        "    \"Model\": \"KNN\",\n",
        "    \"Scratch F1 (macro)\": knn_metrics[\"F1-score (macro)\"],\n",
        "    \"Sklearn F1 (macro)\": f1_score(\n",
        "        y_val_knn, sklearn_knn_preds, average=\"macro\", zero_division=0\n",
        "    ),\n",
        "    \"Scratch Accuracy\": knn_metrics[\"Accuracy\"],\n",
        "    \"Sklearn Accuracy\": accuracy_score(y_val_knn, sklearn_knn_preds),\n",
        "}]\n",
        "\n",
        "# Summary perbandingan, mengikuti format tabel perbandingan SVM.\n",
        "display(pd.DataFrame(sklearn_knn_results).set_index(\"Model\"))\n",
        "\n",
        "# Laporan klasifikasi dan confusion matrix dari implementasi scikit-learn.\n",
        "print(\"Classification Report (scikit-learn KNN):\")\n",
        "print(classification_report(y_val_knn, sklearn_knn_preds, zero_division=0))\n",
        "\n",
        "print(\"Confusion Matrix (scikit-learn KNN):\")\n",
        "display(pd.DataFrame(\n",
        "    confusion_matrix(y_val_knn, sklearn_knn_preds),\n",
        "    index=[f\"Actual {label}\" for label in sklearn_knn.classes_],\n",
        "    columns=[f\"Predicted {label}\" for label in sklearn_knn.classes_],\n",
        "))\n"
      ]
    },
