          ]
        }
      ],
      "source": [
        "# imputasi, scaling, dan encoding digabungkan dalam pipeline pre-processing.\n",
        "transformers = []\n",
        "if numerical_cols:\n",
        "    transformers.append((\"num\", numeric_transformer, numerical_cols))\n",
        "if categorical_cols:\n",
        "    transformers.append((\"cat\", categorical_transformer, categorical_cols))\n",
        "\n",
        "preprocessor = ColumnTransformer(\n",
        "    transformers=transformers,\n",
        "    remainder=\"drop\",\n",
        "    verbose_feature_names_out=False\n",
        ")\n",
        "\n",
        "# Fit hanya pada training; validation dan test hanya ditransformasi.\n",
        "X_train_array = preprocessor.fit_transform(X_train)\n",
        "X_val_array = preprocessor.transform(X_val)\n",
        "X_test_array = preprocessor.transform(X_test)\n",
        "\n",
        "feature_names = preprocessor.get_feature_names_out()\n",
        "X_train_processed = pd.DataFrame(X_train_array, columns=feature_names, index=X_train.index)\n",
        "X_val_processed = pd.DataFrame(X_val_array, columns=feature_names, index=X_val.index)\n",
        "X_test_processed = pd.DataFrame(X_test_array, columns=feature_names)\n",
        "\n",
        "# fit pada training saja.\n",
        "if dimensionality_reducer is not None:\n",
        "    train_reduced = dimensionality_reducer.fit_transform(X_train_processed)\n",
        "    val_reduced = dimensionality_reducer.transform(X_val_processed)\n",
        "    test_reduced = dimensionality_reducer.transform(X_test_processed)\n",
        "\n",
        "    component_names = [f\"PC{i+1}\" for i in range(train_reduced.shape[1])]\n",
        "    X_train_processed = pd.DataFrame(train_reduced, columns=component_names)\n",
        "    X_val_processed = pd.DataFrame(val_reduced, columns=component_names)\n",
        "    X_test_processed = pd.DataFrame(test_reduced, columns=component_names)\n",
        "\n",
        "# Random oversampling opsional dan hanya diterapkan pada training set.\n",
        "# Validation set dibuat tidak seimbangkan agar evaluasi merepresentasikan distribusi asli.\n",
        "if CFG.APPLY_RANDOM_OVERSAMPLING:\n",
        "    counts = y_train.value_counts()\n",
        "    majority_count = counts.max()\n",
        "    sampled_indices = []\n",
        "    rng = np.random.default_rng(CFG.SEED)\n",
        "\n",
        "    for label, count in counts.items():\n",
        "        label_indices = np.flatnonzero(y_train.to_numpy() == label)\n",
        "        sampled_indices.extend(label_indices.tolist())\n",
        "        if count < majority_count:\n",
        "            sampled_indices.extend(\n",
        "                rng.choice(label_indices, size=majority_count-count, replace=True).tolist()\n",
        "            )\n",
        "\n",
        "    rng.shuffle(sampled_indices)\n",
        "    X_train_processed = X_train_processed.iloc[sampled_indices].reset_index(drop=True)\n",
        "    y_train_processed = y_train.iloc[sampled_indices].reset_index(drop=True)\n",
        "else:\n",
        "    y_train_processed = y_train.reset_index(drop=True)\n",
        "\n",
        "y_val_processed = y_val.reset_index(drop=True)\n",
        "\n",
        "print(\"Training processed  :\", X_train_processed.shape, y_train_processed.shape)\n",
        "print(\"Validation processed:\", X_val_processed.shape, y_val_processed.shape)\n",
        "print(\"Test processed      :\", X_test_processed.shape)"
      ]
    },
