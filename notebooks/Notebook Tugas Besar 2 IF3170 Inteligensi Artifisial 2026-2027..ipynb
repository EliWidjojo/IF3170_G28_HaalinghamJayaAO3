        "    sub_idx = rng.choice(len(X_train_svm), size=2000, replace=False)\n",
        "    X_tr_sk, y_tr_sk = X_train_svm[sub_idx], y_train_svm[sub_idx]\n",
        "else:\n",
        "    X_tr_sk, y_tr_sk = X_train_svm, y_train_svm\n",
        "\n",
        "for kernel_name in [\"linear\", \"poly\", \"rbf\"]:\n",
        "    if kernel_name == \"linear\":\n",
        "        sk_svm = LinearSVC(C=1.0, random_state=CFG.SEED, max_iter=2000)\n",
        "        sk_svm.fit(X_train_svm, y_train_svm)\n",
        "    else:\n",
        "        sk_svm = SVC(kernel=kernel_name, C=1.0, degree=3, gamma=\"scale\", random_state=CFG.SEED)\n",
        "        sk_svm.fit(X_tr_sk, y_tr_sk)\n",
        "\n",
        "    sk_preds = sk_svm.predict(X_val_svm)\n",
        "    sklearn_svm_results.append({\n",
        "        \"Kernel\": kernel_name,\n",
        "        \"Scratch F1 (macro)\": svm_summary_df.loc[kernel_name, \"F1-score (macro)\"],\n",
        "        \"Sklearn F1 (macro)\": f1_score(y_val_svm, sk_preds, average=\"macro\", zero_division=0),\n",
        "        \"Scratch Accuracy\": svm_summary_df.loc[kernel_name, \"Accuracy\"],\n",
        "        \"Sklearn Accuracy\": accuracy_score(y_val_svm, sk_preds),\n",
        "    })\n",
        "\n",
        "display(pd.DataFrame(sklearn_svm_results).set_index(\"Kernel\"))"
